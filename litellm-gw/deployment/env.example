# LiteLLM Gateway — Environment Variables
# Copy this file to .env and fill in your actual values.
# Usage: cp .env.example .env && vim .env

# ── Startup performance ───────────────────────────────────────
# Disable telemetry (belt-and-suspenders alongside config.yaml setting)
LITELLM_TELEMETRY=False
DISABLE_TELEMETRY=True
# Skip loading the web UI dashboard (saves startup time + RAM)
DISABLE_UI=True
# Point to the pre-downloaded tiktoken BPE cache (avoids CDN fetches at startup).
# Run deployment/download-tiktoken-cache.sh once to populate this directory.
# Value here is the CONTAINER-internal path; run.sh mounts the host dir there.
TIKTOKEN_CACHE_DIR=/tmp/tiktoken_cache

# ── LiteLLM Admin ────────────────────────────────────────────
LITELLM_MASTER_KEY=your-super-secret-master-key

# ── Cloud Providers ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...

# ── Red Hat MaaS ─────────────────────────────────────────────
REDHAT_API_KEY=your-redhat-maas-api-key
REDHAT_MAAS_BASE_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1

# ── Local vLLM (rootless Podman: use host.containers.internal) ─
# Set VLLM_MODEL to whatever model name your vLLM server serves.
VLLM_BASE_URL=http://host.containers.internal:8000/v1
VLLM_MODEL=your-vllm-model-name
