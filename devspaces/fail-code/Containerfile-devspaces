# OpenCode AI — OpenShift DevSpaces image
#
# Layers the opencode binary onto the UDI ubi9 base so workspaces start
# instantly without an on-start install step.
#
# Build:
#   podman build \
#     -t quay.io/kenghua_yeo/opencode-devspaces:latest \
#     -f devspaces/opencode/Containerfile-devspaces \
#     devspaces/opencode/
#
# Push:
#   podman push quay.io/kenghua_yeo/opencode-devspaces:latest
#
# Update opencode:
#   Rebuild with --no-cache and repush; the devfile image ref picks it up on
#   the next workspace restart (DevSpaces pulls Always by default).

FROM quay.io/devfile/universal-developer-image:ubi9-latest

USER root

# Install the latest opencode binary.
RUN curl -fsSL https://opencode.ai/install | bash 

# Required because DevSpaces proxies TLS and the self-signed cert would
# otherwise cause Node.js-based tooling (used by opencode) to fail.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0 \
    HOME=/home/user

USER 10001
